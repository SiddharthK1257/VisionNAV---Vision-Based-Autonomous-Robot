# VisionNav AI Configuration

# Server Settings
HOST=0.0.0.0
PORT=8000
FRONTEND_PORT=5173
ENVIRONMENT=development

# Simulation Settings
SIMULATION_MODE=true
SIMULATION_FPS=20
DEFAULT_ENVIRONMENT=warehouse

# Robot Kinematics & Limits
MAX_LINEAR_VELOCITY=0.8
MAX_ANGULAR_VELOCITY=1.2
WHEEL_BASE=0.45
WHEEL_RADIUS=0.10
ACCELERATION_LIMIT=0.6

# Safety Controller
CRITICAL_OBSTACLE_DISTANCE=0.45
WARNING_OBSTACLE_DISTANCE=1.20
SAFETY_MARGIN=0.25

# Vision-Language Model
VLM_PROVIDER=local_fallback
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
